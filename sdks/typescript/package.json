{
  "name": "otra",
  "version": "0.1.0",
  "description": "Generator-based durable execution on Postgres, built on durable promises. From the top.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muniter/otra.git"
  },
  "keywords": [
    "durable-execution",
    "durable-promises",
    "postgres",
    "workflow",
    "generators",
    "task-queue",
    "saga",
    "orchestration"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "prebuild": "npm run prepare-assets",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run prepare-assets",
    "prepack": "npm run build",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
