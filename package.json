{
  "name": "otra",
  "version": "0.1.0",
  "description": "Generator-based durable execution on Postgres, built on durable promises. From the top.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-global-setup=tests/global-setup.ts tests/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
